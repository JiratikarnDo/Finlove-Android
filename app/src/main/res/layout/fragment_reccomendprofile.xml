<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/txttitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="12dp"
        android:text="ให้เราช่วยคุณ"
        android:textColor="#0DD7E9"
        android:textSize="36sp"
        android:layout_marginStart="12dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/txtDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.163"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="36dp"
        android:text="รับคำแนะนำการแก้ไขโปรไฟล์เพื่อรับประสบการณ์ที่ดีขึ้น"
        android:textColor="#000000"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/txttitle"
        app:layout_constraintTop_toBottomOf="@id/txttitle" />

    <ImageView
        android:id="@+id/imgMascot"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="180dp"
        app:srcCompat="@drawable/ic_mascot"
        app:layout_constraintTop_toBottomOf="@id/txtDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- แทน TextView เดิม -->
    <TextSwitcher
        android:id="@+id/txtQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
    android:background="@drawable/bg_speech_bubble_down"
    android:padding="12dp"
    android:layout_marginTop="80dp"
    android:layout_marginEnd="2dp"
    android:maxLines="3"
    android:ellipsize="end"
    app:layout_constrainedWidth="true"
    app:layout_constraintTop_toBottomOf="@id/txtDescription"
    app:layout_constraintStart_toStartOf="@id/txtDescription"
    app:layout_constraintEnd_toStartOf="@id/imgMascot" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResult"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/txtDescription"
        app:layout_constraintStart_toStartOf="@id/txtDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnHelpNow" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnHelpNow"
        android:layout_width="0dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_height="wrap_content"
        android:text="ใช่แล้ว !"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_pressed"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@id/imgMascot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNotNow"
        android:layout_width="0dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/button_normal"
        android:text="ไว้ทีหลัง !"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.508"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnHelpNow"
        app:layout_constraintVertical_bias="0.096" />


</androidx.constraintlayout.widget.ConstraintLayout>