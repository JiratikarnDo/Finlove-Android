<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/newbg"
    tools:context=".OtpVerifyActivity">

    <!-- หัวข้อ -->
    <TextView
        android:id="@+id/enterOtpText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ยืนยันรหัส OTP"
        android:textColor="@color/blue_main"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginTop="220dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/otpRow"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="12dp"/>

    <!-- คำอธิบาย -->
    <TextView
        android:id="@+id/otpSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="กรุณากรอกรหัส 6 หลักที่ส่งไปทางอีเมลของคุณ"
        android:textSize="14sp"
        android:textColor="#6B7280"
        app:layout_constraintTop_toBottomOf="@id/enterOtpText"
        app:layout_constraintStart_toStartOf="@id/otpRow" />

    <!-- แถว OTP 6 ช่อง -->
    <LinearLayout
        android:id="@+id/otpRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="45dp"
        android:layout_marginRight="45dp"
        android:maxWidth="360dp"
        app:layout_constraintTop_toBottomOf="@id/otpSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ช่องละ 1 ตัวอักษร -->
        <EditText
            android:id="@+id/otp1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:digits="0123456789"
            android:textSize="18sp"
            android:autofillHints="smsOtp"
            android:importantForAutofill="yes"
            android:imeOptions="flagNoPersonalizedLearning"
            android:background="@drawable/button_normal"/>

        <EditText
            android:id="@+id/otp2"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:digits="0123456789"
            android:textSize="18sp"
            android:autofillHints="smsOtp"
            android:importantForAutofill="yes"
            android:imeOptions="flagNoPersonalizedLearning"
            android:background="@drawable/button_normal"/>

        <EditText
            android:id="@+id/otp3"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:digits="0123456789"
            android:textSize="18sp"
            android:autofillHints="smsOtp"
            android:importantForAutofill="yes"
            android:imeOptions="flagNoPersonalizedLearning"
            android:background="@drawable/button_normal"/>

        <EditText
            android:id="@+id/otp4"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:digits="0123456789"
            android:textSize="18sp"
            android:autofillHints="smsOtp"
            android:importantForAutofill="yes"
            android:imeOptions="flagNoPersonalizedLearning"
            android:background="@drawable/button_normal"/>

        <EditText
            android:id="@+id/otp5"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:digits="0123456789"
            android:textSize="18sp"
            android:autofillHints="smsOtp"
            android:importantForAutofill="yes"
            android:imeOptions="flagNoPersonalizedLearning"
            android:background="@drawable/button_normal"/>

        <EditText
            android:id="@+id/otp6"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:digits="0123456789"
            android:textSize="18sp"
            android:autofillHints="smsOtp"
            android:importantForAutofill="yes"
            android:imeOptions="flagNoPersonalizedLearning"
            android:background="@drawable/button_normal"/>
    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/otpRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- ปุ่มยืนยัน -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/submitButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:text="ยืนยัน"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:background="@drawable/button_pressed"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="@id/otpRow"
        app:layout_constraintEnd_toEndOf="@id/otpRow"/>

    <!-- ปุ่มส่งรหัสใหม่ + นับถอยหลัง -->
    <LinearLayout
        android:id="@+id/resendRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/submitButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/resendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="ส่งรหัสใหม่"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:background="@drawable/button_normal"/>

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text=""
            android:textColor="#6B7280"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
