<!-- res/drawable/bg_speech_bubble_down.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- กล่องหลัก -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bubble_fill"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/bubble_stroke"/>
            <!-- เผื่อพื้นที่ด้านล่างให้หาง ไม่ให้ทับข้อความ -->
            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="16dp"/>
        </shape>
    </item>

    <!-- หางชี้ลง (วางกึ่งกลางล่าง; จะอยู่ "ใน" ขอบเขตวิว) -->
    <item
        android:drawable="@drawable/bg_speech_tail_down"
        android:gravity="bottom|center_horizontal"/>
</layer-list>
