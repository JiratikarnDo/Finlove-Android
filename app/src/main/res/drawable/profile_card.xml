<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- เงาของการ์ด -->
    <item android:right="4dp" android:left="4dp" android:top="4dp" android:bottom="4dp">
        <shape>
            <solid android:color="#80000000" /> <!-- สีเงา (สีดำโปร่งแสง) -->
            <corners android:radius="16dp" />   <!-- ขอบมน -->
        </shape>
    </item>

    <!-- พื้นหลังของการ์ด -->
    <item>
        <shape>
            <solid android:color="#0DD7E9" /> <!-- สีฟ้า -->
            <corners android:radius="16dp" />  <!-- ขอบมน -->
        </shape>
    </item>
</layer-list>